---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import { Schema } from "astro-seo-schema";
import { siteConfig } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    authors?: string[];
    tags?: string[];
  };
  noindex?: boolean;
}

const { title, description, image, article, noindex = false } = Astro.props;
const pageTitle = title ? `${title} - ${siteConfig.name}` : `${siteConfig.name} - ${siteConfig.title}`;
const pageDescription = description || siteConfig.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image || "/og-default.png";
const ogImageURL = new URL(ogImage, Astro.site).toString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <SEO
      title={pageTitle}
      description={pageDescription}
      canonical={canonicalURL.toString()}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: pageTitle,
          type: article ? "article" : "website",
          image: ogImageURL,
          url: canonicalURL.toString(),
        },
        optional: {
          description: pageDescription,
          siteName: siteConfig.name,
          locale: "en_US",
        },
        image: {
          alt: pageTitle,
        },
        article: article ? {
          publishedTime: article.publishedTime,
          modifiedTime: article.modifiedTime,
          authors: article.authors,
          tags: article.tags,
        } : undefined,
      }}
      twitter={{
        card: "summary_large_image",
        site: siteConfig.social.twitter ? `@${siteConfig.social.twitter.split('/').pop()}` : undefined,
        creator: siteConfig.social.twitter ? `@${siteConfig.social.twitter.split('/').pop()}` : undefined,
        title: pageTitle,
        description: pageDescription,
        image: ogImageURL,
      }}
      extend={{
        meta: [
          { name: "author", content: siteConfig.name },
          { name: "theme-color", content: siteConfig.accentColor },
        ],
      }}
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} Blog RSS`} href="/rss.xml" />

    <!-- Structured Data: Person -->
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "Person",
        name: siteConfig.name,
        jobTitle: siteConfig.title,
        url: Astro.site?.toString(),
        email: siteConfig.social.email,
        sameAs: [
          siteConfig.social.linkedin,
          siteConfig.social.twitter,
          siteConfig.social.github,
        ].filter(Boolean),
      }}
    />

    <!-- Structured Data: WebSite -->
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: `${siteConfig.name} - Portfolio`,
        description: siteConfig.description,
        url: Astro.site?.toString(),
        author: {
          "@type": "Person",
          name: siteConfig.name,
        },
      }}
    />

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Additional head content from child layouts -->
    <slot name="head" />
  </head>
  <body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-gray-100 transition-colors duration-300" style={`--accent: ${siteConfig.accentColor}; --accent-dark: ${siteConfig.accentColorDark}`}>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
