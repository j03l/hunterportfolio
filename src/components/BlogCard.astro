---
import { siteConfig } from "../config";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  tags?: string[];
  readTime?: string;
}

const { title, description, pubDate, slug, tags = [], readTime } = Astro.props;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={`/blog/${slug}`}
  class="block relative bg-white dark:bg-gray-900 rounded-lg shadow-sm border border-gray-100 dark:border-gray-800 p-4 sm:p-5 md:p-6 hover:shadow-md transition-all duration-300 group hover:-translate-y-1 cursor-pointer overflow-hidden"
>
  <div
    class="absolute top-4 right-4 sm:top-5 sm:right-5 md:top-6 md:right-6 w-9 h-9 sm:w-10 sm:h-10 flex items-center justify-center rounded-full text-white dark:text-gray-900 bg-yellow-500 dark:bg-yellow-400 transition-all duration-300 group-hover:opacity-90"
  >
    <svg
      class="w-4 h-4 arrow-icon"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M13 7l5 5m0 0l-5 5m5-5H6"
      />
    </svg>
  </div>
  <article class="pr-12 sm:pr-14">
    <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <time>{formattedDate}</time>
      {readTime && (
        <>
          <span>·</span>
          <span>{readTime}</span>
        </>
      )}
    </div>
    <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mt-2 mb-2 group-hover:text-yellow-500 dark:group-hover:text-yellow-400 transition-colors">
      {title}
    </h3>
    <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2 mb-4">
      {description}
    </p>
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.slice(0, 3).map((tag) => (
            <span
              class="px-2 py-1 rounded-full text-xs font-medium bg-yellow-500/15 text-yellow-600 dark:bg-yellow-400/15 dark:text-yellow-400"
            >
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </article>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .arrow-icon {
    transition: transform 0.3s ease;
  }

  .group:hover .arrow-icon {
    animation:
      spin-and-push 1s ease-out forwards,
      pulse-right 2s ease-in-out 1s infinite;
  }

  @keyframes spin-and-push {
    0% { transform: rotate(0deg); }
    70% { transform: rotate(360deg); }
    100% { transform: rotate(360deg) translateX(4px); }
  }

  @keyframes pulse-right {
    0%, 45% { transform: rotate(360deg) translateX(4px); }
    50%, 95% { transform: rotate(360deg) translateX(0); }
    100% { transform: rotate(360deg) translateX(4px); }
  }
</style>
