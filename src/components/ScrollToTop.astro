<!-- Scroll to Top Button -->
<button
  id="scroll-to-top"
  class="scroll-to-top-btn"
  aria-label="Scroll to top"
>
  <svg
    class="scroll-top-arrow"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M12 19V5M5 12l7-7 7 7"
    />
  </svg>
</button>

<script>
  function initScrollToTop() {
    const scrollBtn = document.getElementById('scroll-to-top');
    const arrow = scrollBtn?.querySelector('.scroll-top-arrow') as HTMLElement | null;
    if (!scrollBtn || !arrow) return;

    let lastScrollY = window.scrollY;
    let lastTime = performance.now();
    let currentRotation = 0;
    let isClicked = false;
    let settleTimer: ReturnType<typeof setTimeout> | null = null;

    function settleToUp() {
      // Snap to nearest 360° multiple (i.e. pointing up)
      const target = Math.round(currentRotation / 360) * 360;
      currentRotation = target;
      arrow.style.transform = `rotate(${target}deg)`;
    }

    scrollBtn.addEventListener('click', () => {
      isClicked = true;
      scrollBtn.classList.add('clicked');
      currentRotation = Math.round(currentRotation / 360) * 360;
      arrow.style.transform = `rotate(${currentRotation}deg)`;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    function onScroll() {
      const scrollY = window.scrollY;
      const now = performance.now();
      const deltaY = scrollY - lastScrollY;
      const deltaTime = now - lastTime;

      // Re-enable on scroll down after click
      if (deltaY > 0 && isClicked) {
        isClicked = false;
        scrollBtn.classList.remove('clicked');
      }

      // Toggle visibility
      scrollBtn.classList.toggle('visible', scrollY > 300);

      // Rotate arrow based on scroll velocity (skip if clicked)
      if (!isClicked && deltaTime > 0) {
        const rotationDelta = deltaY * 0.5;
        currentRotation += rotationDelta;
        arrow.style.transform = `rotate(${currentRotation}deg)`;
      }

      // Reset settle timer — snap back to up when scrolling stops
      if (settleTimer) clearTimeout(settleTimer);
      settleTimer = setTimeout(settleToUp, 150);

      lastScrollY = scrollY;
      lastTime = now;
    }

    function syncVisibility() {
      scrollBtn.classList.toggle('visible', window.scrollY > 300);
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Check immediately and after scroll restoration (browser may restore
    // scroll position after DOMContentLoaded / paint)
    syncVisibility();
    requestAnimationFrame(syncVisibility);
  }

  initScrollToTop();
  document.addEventListener('astro:page-load', initScrollToTop);
</script>

<style is:global>
  .scroll-to-top-btn {
    position: fixed;
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    right: 1.5rem;
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    background-color: #eab308;
    color: white;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, background-color 0.2s ease, transform 0.2s ease;
    z-index: 50;
    cursor: pointer;
    border: none;
  }

  @media (max-width: 640px) {
    .scroll-to-top-btn {
      width: 3.5rem;
      height: 3.5rem;
      bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
      right: 1.25rem;
    }

    .scroll-top-arrow {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  @media (hover: hover) {
    .scroll-to-top-btn:not(.clicked):hover {
      background-color: #ca8a04;
      transform: translateY(-4px) scale(1.1);
    }
  }

  .scroll-to-top-btn.visible {
    opacity: 1;
    pointer-events: auto;
  }

  .scroll-top-arrow {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.3s ease-out;
  }

  .scroll-to-top-btn.is-scrolling .scroll-top-arrow {
    animation: scroll-spin 0.5s linear infinite;
  }

  @media (max-width: 640px) {
    .scroll-to-top-btn.is-scrolling .scroll-top-arrow {
      animation-duration: 0.3s;
    }
  }

  @keyframes scroll-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-color-scheme: dark) {
    .scroll-to-top-btn {
      background-color: #facc15;
      color: #111827;
    }

    @media (hover: hover) {
      .scroll-to-top-btn:not(.clicked):hover {
        background-color: #fde047;
      }
    }
  }
</style>
