---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === "/" || currentPath === "";
const homePrefix = isHomePage ? "" : "/";

const isBlogPage = currentPath.startsWith("/blog");
const isCVPage = currentPath === "/cv" || currentPath === "/cv/";
---

<!-- Mobile Nav Button -->
<button
  id="mobile-nav-btn"
  class="mobile-nav-btn"
  aria-label="Open navigation menu"
  aria-expanded="false"
>
  <svg class="hamburger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
  <svg class="close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
  </svg>
</button>

<!-- Backdrop -->
<div id="mobile-nav-backdrop" class="mobile-nav-backdrop"></div>

<!-- Bottom Sheet Menu -->
<nav id="mobile-nav-sheet" class="mobile-nav-sheet" aria-hidden="true">
  <ul class="mobile-nav-list">
    <li>
      <a href={`${homePrefix}#about`} class="mobile-nav-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
          <circle cx="12" cy="7" r="4" />
        </svg>
        <span>About</span>
      </a>
    </li>
    {hasProjects && (
      <li>
        <a href={`${homePrefix}#projects`} class="mobile-nav-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
          </svg>
          <span>Projects</span>
        </a>
      </li>
    )}
    {hasExperience && (
      <li>
        <a href={`${homePrefix}#experience`} class="mobile-nav-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
          </svg>
          <span>Experience</span>
        </a>
      </li>
    )}
    {hasEducation && (
      <li>
        <a href={`${homePrefix}#education`} class="mobile-nav-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
          <span>Education</span>
        </a>
      </li>
    )}
    <li>
      <a href="/blog" class:list={["mobile-nav-link", { "is-active": isBlogPage }]}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19l7-7 3 3-7 7-3-3z" />
          <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
          <path d="M2 2l7.586 7.586" />
          <circle cx="11" cy="11" r="2" />
        </svg>
        <span>Blog</span>
      </a>
    </li>
    <li>
      <a href="/cv" class:list={["mobile-nav-link", { "is-active": isCVPage }]}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
          <line x1="16" y1="13" x2="8" y2="13" />
          <line x1="16" y1="17" x2="8" y2="17" />
          <polyline points="10 9 9 9 8 9" />
        </svg>
        <span>CV</span>
      </a>
    </li>
  </ul>
</nav>

<script>
  function initMobileNav() {
    const btn = document.getElementById('mobile-nav-btn');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const sheet = document.getElementById('mobile-nav-sheet');
    const links = sheet?.querySelectorAll('.mobile-nav-link');

    if (!btn || !backdrop || !sheet) return;

    let isOpen = false;

    function open() {
      isOpen = true;
      btn.classList.add('is-open');
      btn.setAttribute('aria-expanded', 'true');
      backdrop.classList.add('is-visible');
      sheet.classList.add('is-open');
      sheet.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      isOpen = false;
      btn.classList.remove('is-open');
      btn.setAttribute('aria-expanded', 'false');
      backdrop.classList.remove('is-visible');
      sheet.classList.remove('is-open');
      sheet.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    btn.addEventListener('click', () => isOpen ? close() : open());
    backdrop.addEventListener('click', close);
    links?.forEach(link => link.addEventListener('click', close));

    // Close on escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) close();
    });
  }

  initMobileNav();
  document.addEventListener('astro:page-load', initMobileNav);
</script>

<style is:global>
  /* Only show on mobile */
  .mobile-nav-btn,
  .mobile-nav-backdrop,
  .mobile-nav-sheet {
    display: none;
  }

  @media (max-width: 767px) {
    .mobile-nav-btn {
      display: flex;
      position: fixed;
      bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
      left: 1.25rem;
      width: 3.5rem;
      height: 3.5rem;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      background-color: #eab308;
      color: white;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
      transition: background-color 0.2s ease, transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
      z-index: 60;
      cursor: pointer;
      border: none;
    }

    .mobile-nav-btn .hamburger-icon,
    .mobile-nav-btn .close-icon {
      width: 1.5rem;
      height: 1.5rem;
      position: absolute;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .mobile-nav-btn .close-icon {
      opacity: 0;
      transform: rotate(-90deg);
    }

    .mobile-nav-btn.is-open {
      transform: translateY(-11rem) scale(0.75);
    }

    .mobile-nav-btn.is-open .hamburger-icon {
      opacity: 0;
      transform: rotate(90deg);
    }

    .mobile-nav-btn.is-open .close-icon {
      opacity: 1;
      transform: rotate(0deg);
    }

    .mobile-nav-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0);
      z-index: 55;
      pointer-events: none;
      transition: background 0.3s ease;
    }

    .mobile-nav-backdrop.is-visible {
      background: rgba(0, 0, 0, 0.4);
      pointer-events: auto;
    }

    .mobile-nav-sheet {
      display: block;
      position: fixed;
      bottom: -50px; /* Extend below viewport to cover iPhone home indicator */
      left: 0;
      right: 0;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-top-left-radius: 1.5rem;
      border-top-right-radius: 1.5rem;
      padding: 1.5rem;
      padding-bottom: calc(1.5rem + 50px + env(safe-area-inset-bottom, 0px));
      z-index: 58;
      transform: translateY(100%);
      transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
    }

    .mobile-nav-sheet.is-open {
      transform: translateY(0);
    }

    .mobile-nav-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem;
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .mobile-nav-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 0.5rem;
      border-radius: 1rem;
      color: #374151;
      text-decoration: none;
      font-size: 0.75rem;
      font-weight: 500;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .mobile-nav-link:active {
      background-color: rgba(234, 179, 8, 0.15);
    }

    .mobile-nav-link.is-active {
      color: #ca8a04;
    }

    .mobile-nav-link svg {
      width: 1.5rem;
      height: 1.5rem;
    }

    .mobile-nav-link.is-active svg {
      stroke: #ca8a04;
    }
  }

  @media (max-width: 767px) and (prefers-color-scheme: dark) {
    .mobile-nav-btn {
      background-color: #facc15;
      color: #111827;
    }

    .mobile-nav-sheet {
      background: rgba(17, 24, 39, 0.85);
    }

    .mobile-nav-link {
      color: #d1d5db;
    }

    .mobile-nav-link.is-active {
      color: #facc15;
    }

    .mobile-nav-link.is-active svg {
      stroke: #facc15;
    }
  }
</style>
