---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config";
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <main class="min-h-screen bg-white dark:bg-gray-950 flex items-center justify-center px-6">
    <div class="text-center">
      <div
        class="w-[75px] h-[5px] rounded-full mx-auto mb-8 bg-yellow-500 dark:bg-yellow-400"
      >
      </div>
      <h1
        class="text-8xl sm:text-9xl font-bold mb-4 text-yellow-500 dark:text-yellow-400"
      >
        404
      </h1>
      <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 dark:text-gray-100 mb-4">
        Page Not Found
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-white dark:text-gray-900 font-medium transition-opacity hover:opacity-90 cursor-pointer bg-yellow-500 dark:bg-yellow-400"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        Back to Home
      </a>
    </div>
  </main>
</BaseLayout>
